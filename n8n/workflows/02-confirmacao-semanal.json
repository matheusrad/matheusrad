{
  "name": "02 - Confirmação Semanal de Consultas",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 8 * * 1" }]
        }
      },
      "id": "trigger-segunda",
      "name": "Toda Segunda às 8h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/consultas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Accept",        "value": "application/json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select",       "value": "id,paciente_nome,paciente_telefone,data_consulta,status,evento_google_id" },
            { "name": "data_consulta", "value": "=gte.{{ $now.startOf('week').plus({ days: 1 }).toISO() }}" },
            { "name": "data_consulta", "value": "=lte.{{ $now.startOf('week').plus({ days: 7 }).toISO() }}" },
            { "name": "status",       "value": "=in.(Agendado,Confirmado)" }
          ]
        },
        "options": {}
      },
      "id": "busca-consultas-semana-supabase",
      "name": "Busca Consultas da Semana (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300],
      "notes": "GET /rest/v1/consultas — filtra consultas desta semana com status Agendado/Confirmado"
    },
    {
      "parameters": {
        "jsCode": "const consultas = $input.first().json;\nif (!Array.isArray(consultas) || consultas.length === 0) {\n  return [{ json: { semVazia: true } }];\n}\nreturn consultas.map(c => {\n  const inicio = new Date(c.data_consulta);\n  const dataFormatada = inicio.toLocaleDateString('pt-BR', { weekday: 'long', day: '2-digit', month: '2-digit' });\n  const horaFormatada = inicio.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });\n  return {\n    json: {\n      consultaId: c.id,\n      nomePaciente: c.paciente_nome,\n      telefone: c.paciente_telefone,\n      dataFormatada,\n      horaFormatada,\n      dataISO: c.data_consulta,\n      podeConfirmar: !!c.paciente_telefone\n    }\n  };\n}).filter(i => i.json.podeConfirmar);"
      },
      "id": "processa-lista",
      "name": "Processa Lista de Pacientes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "={{ $vars.EVOLUTION_API_URL }}/message/sendText/{{ $vars.EVOLUTION_INSTANCE }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": [
          { "name": "apikey", "value": "={{ $vars.EVOLUTION_API_KEY }}" }
        ],
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.telefone }}\",\n  \"text\": \"Olá, {{ $json.nomePaciente }}! 😊\\n\\nPassando para confirmar sua consulta com a Dra. {{ $vars.NOME_DENTISTA }}:\\n\\n📅 *{{ $json.dataFormatada }}*\\n🕐 *{{ $json.horaFormatada }}*\\n\\nResponda:\\n✅ *SIM* — confirmar\\n🔄 *REMARCAR* — outro horário\\n❌ *CANCELAR* — cancelar\\n\\n{{ $vars.ENDERECO_LOGRADOURO }}, {{ $vars.ENDERECO_NUMERO }} — {{ $vars.ENDERECO_BAIRRO }}\\n\\nAté logo! 🦷\"\n}",
        "options": {}
      },
      "id": "envia-confirmacao",
      "name": "Envia Confirmação WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/consultas?id=eq.{{ $json.consultaId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type",  "value": "application/json" },
            { "name": "Prefer",        "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"confirmacao_enviada\": true,\n  \"confirmacao_enviada_em\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "marca-confirmacao-enviada",
      "name": "Marca Confirmação Enviada (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 300],
      "notes": "PATCH /rest/v1/consultas?id=eq.UUID — atualiza flag de confirmação enviada"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "confirmacao-resposta",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-resposta",
      "name": "Webhook — Resposta do Paciente",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 600]
    },
    {
      "parameters": {
        "jsCode": "const dados = $input.first().json;\nconst telefone = dados.telefone || '';\nconst texto = (dados.texto || '').toLowerCase().trim();\nlet acao = 'desconhecido';\nif (texto.includes('sim') || texto.includes('confirmo') || texto === '1') acao = 'confirmado';\nelse if (texto.includes('remarcar') || texto.includes('remarca') || texto === '2') acao = 'remarcar';\nelse if (texto.includes('cancelar') || texto.includes('cancela') || texto === '3') acao = 'cancelado';\nreturn [{ json: { telefone, acao, texto } }];"
      },
      "id": "interpreta-resposta",
      "name": "Interpreta Resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 600]
    },
    {
      "parameters": {
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/consultas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Accept",        "value": "application/json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "paciente_telefone",    "value": "=eq.{{ $json.telefone }}" },
            { "name": "confirmacao_enviada",  "value": "=eq.true" },
            { "name": "status",              "value": "=in.(Agendado,Confirmado)" },
            { "name": "order",              "value": "data_consulta.asc" },
            { "name": "limit",              "value": "1" },
            { "name": "select",             "value": "id,data_consulta,paciente_nome" }
          ]
        },
        "options": {}
      },
      "id": "busca-consulta-paciente",
      "name": "Busca Consulta do Paciente (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [680, 600]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            { "operation": "equal", "value1": "={{ $('Interpreta Resposta').item.json.acao }}", "value2": "confirmado" },
            { "operation": "equal", "value1": "={{ $('Interpreta Resposta').item.json.acao }}", "value2": "remarcar" },
            { "operation": "equal", "value1": "={{ $('Interpreta Resposta').item.json.acao }}", "value2": "cancelado" }
          ]
        }
      },
      "id": "switch-acao",
      "name": "Switch: Ação",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [900, 600]
    },
    {
      "parameters": {
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/consultas?id=eq.{{ $input.first().json[0]?.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"status\": \"Confirmado\", \"confirmacao_resposta\": \"SIM\", \"confirmacao_em\": \"{{ new Date().toISOString() }}\" }",
        "options": {}
      },
      "id": "update-confirmado",
      "name": "Atualiza: Confirmado (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 480]
    },
    {
      "parameters": {
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/consultas?id=eq.{{ $input.first().json[0]?.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"status\": \"Cancelado\", \"confirmacao_resposta\": \"CANCELAR\", \"confirmacao_em\": \"{{ new Date().toISOString() }}\" }",
        "options": {}
      },
      "id": "update-cancelado",
      "name": "Atualiza: Cancelado (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 720]
    },
    {
      "parameters": {
        "url": "={{ $vars.EVOLUTION_API_URL }}/message/sendText/{{ $vars.EVOLUTION_INSTANCE }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": [{ "name": "apikey", "value": "={{ $vars.EVOLUTION_API_KEY }}" }],
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"number\": \"{{ $('Interpreta Resposta').item.json.telefone }}\", \"text\": \"Perfeito! ✅ Consulta confirmada. Te esperamos! 🦷\" }",
        "options": {}
      },
      "id": "msg-confirmado",
      "name": "Msg: Confirmado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1340, 480]
    },
    {
      "parameters": {
        "url": "={{ $vars.EVOLUTION_API_URL }}/message/sendText/{{ $vars.EVOLUTION_INSTANCE }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": [{ "name": "apikey", "value": "={{ $vars.EVOLUTION_API_KEY }}" }],
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"number\": \"{{ $('Interpreta Resposta').item.json.telefone }}\", \"text\": \"Claro! Vamos encontrar outro horário. 🗓️\\n\\nQual período você prefere?\\n1️⃣ Manhã (8h-12h)\\n2️⃣ Tarde (13h-18h)\\n\\nE qual dia da semana?\" }",
        "options": {}
      },
      "id": "msg-remarcar",
      "name": "Msg: Remarcar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1340, 600]
    },
    {
      "parameters": {
        "url": "={{ $vars.EVOLUTION_API_URL }}/message/sendText/{{ $vars.EVOLUTION_INSTANCE }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": [{ "name": "apikey", "value": "={{ $vars.EVOLUTION_API_KEY }}" }],
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"number\": \"{{ $('Interpreta Resposta').item.json.telefone }}\", \"text\": \"Tudo bem! Consulta cancelada. 😊 Quando quiser agendar novamente, é só chamar! Cuide-se! 🦷\" }",
        "options": {}
      },
      "id": "msg-cancelado",
      "name": "Msg: Cancelado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1340, 720]
    }
  ],
  "connections": {
    "Toda Segunda às 8h": {
      "main": [[{ "node": "Busca Consultas da Semana (Supabase)", "type": "main", "index": 0 }]]
    },
    "Busca Consultas da Semana (Supabase)": {
      "main": [[{ "node": "Processa Lista de Pacientes", "type": "main", "index": 0 }]]
    },
    "Processa Lista de Pacientes": {
      "main": [[{ "node": "Envia Confirmação WhatsApp", "type": "main", "index": 0 }]]
    },
    "Envia Confirmação WhatsApp": {
      "main": [[{ "node": "Marca Confirmação Enviada (Supabase)", "type": "main", "index": 0 }]]
    },
    "Webhook — Resposta do Paciente": {
      "main": [[{ "node": "Interpreta Resposta", "type": "main", "index": 0 }]]
    },
    "Interpreta Resposta": {
      "main": [[{ "node": "Busca Consulta do Paciente (Supabase)", "type": "main", "index": 0 }]]
    },
    "Busca Consulta do Paciente (Supabase)": {
      "main": [[{ "node": "Switch: Ação", "type": "main", "index": 0 }]]
    },
    "Switch: Ação": {
      "main": [
        [{ "node": "Atualiza: Confirmado (Supabase)", "type": "main", "index": 0 }],
        [{ "node": "Msg: Remarcar", "type": "main", "index": 0 }],
        [{ "node": "Atualiza: Cancelado (Supabase)", "type": "main", "index": 0 }]
      ]
    },
    "Atualiza: Confirmado (Supabase)": {
      "main": [[{ "node": "Msg: Confirmado", "type": "main", "index": 0 }]]
    },
    "Atualiza: Cancelado (Supabase)": {
      "main": [[{ "node": "Msg: Cancelado", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["dental", "whatsapp", "confirmacao", "supabase"]
}
