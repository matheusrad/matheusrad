# Copie este arquivo para .env.local e preencha os valores

# Supabase — encontre em Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Conexão direta com o banco — usada apenas pelo script db:setup
# Encontre em: Supabase → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[SENHA]@db.xxxxx.supabase.co:5432/postgres

# n8n webhooks (opcional — para integração com automações)
NEXT_PUBLIC_N8N_WEBHOOK_PRESCRICAO=http://localhost:5678/webhook/prescricao
NEXT_PUBLIC_N8N_WEBHOOK_NOTA_FISCAL=http://localhost:5678/webhook/nota-fiscal
