# Copie este arquivo para .env.local e preencha os valores

# Supabase — encontre em Settings > API Keys no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Chave secreta — usada apenas no servidor (API routes). NUNCA use com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# n8n webhooks (opcional — para integração com automações)
NEXT_PUBLIC_N8N_WEBHOOK_PRESCRICAO=http://localhost:5678/webhook/prescricao
NEXT_PUBLIC_N8N_WEBHOOK_NOTA_FISCAL=http://localhost:5678/webhook/nota-fiscal
