# ============================================================
# SecretárIA Dental — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA faça commit do .env com dados reais!
# ============================================================

# ── Claude / Anthropic ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXX

# ── Evolution API (WhatsApp) ───────────────────────────────
EVOLUTION_API_KEY=CHAVE_SECRETA_EVOLUTION_AQUI
EVOLUTION_INSTANCE=consultorio

# ── Supabase (PostgreSQL) ──────────────────────────────────
# Encontre em: supabase.com → seu projeto → Settings → API Keys
SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
# Chave secreta do projeto (Settings → API Keys → Chaves secretas)
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXX
# Chave anônima/publicável (Settings → API Keys → Chave publicável)
SUPABASE_ANON_KEY=sb_publishable_XXXXXXXX

# ── Setup do banco de dados ────────────────────────────────
# Necessário apenas para rodar: node scripts/setup-db.mjs
# ID do projeto (Settings → Em geral → ID do projeto)
SUPABASE_PROJECT_REF=XXXXXXXXXXXXXXXX
# Token pessoal de acesso — gere em: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_XXXXXXXX

# ── Google APIs ────────────────────────────────────────────
# ID da agenda do Google Calendar (encontre em: Calendar → Configurações → Integração de agenda)
GOOGLE_CALENDAR_ID=seuemail@gmail.com

# ID das pastas no Google Drive (apenas para PDFs — dados ficam no Supabase)
GOOGLE_DRIVE_ANAMNESES_FOLDER_ID=1A2B3C4D5E6F7G8H9I0J
GOOGLE_DRIVE_DOCUMENTOS_FOLDER_ID=1K2L3M4N5O6P7Q8R9S0T

# URL do Google Forms de Anamnese (após criar o formulário)
GOOGLE_FORMS_ANAMNESE_URL=https://forms.gle/XXXXXXXXXXXXXXXX

# ── Meta / Instagram ───────────────────────────────────────
# ID do usuário do Instagram Business
INSTAGRAM_USER_ID=123456789012345
# Token de acesso da Meta Graph API (válido por 60 dias, renovar periodicamente)
META_ACCESS_TOKEN=EAAxxxxxxxxxxxx

# ── Focus NF-e ─────────────────────────────────────────────
# Token da API Focus NF-e (obtenha em focusnfe.com.br)
FOCUSNFE_TOKEN=token_producao_XXXXXXXX

# ── Dados do Consultório ───────────────────────────────────
CNPJ_CONSULTORIO=00.000.000/0001-00
INSCRICAO_MUNICIPAL=000000000
RAZAO_SOCIAL=DRA FULANA DE TAL SERVICOS ODONTOLOGICOS LTDA
NOME_FANTASIA=Consultório Dra. Fulana
EMAIL_CONSULTORIO=contato@consultoriodra.com.br
TELEFONE_CONSULTORIO=(11) 99999-9999
ENDERECO_LOGRADOURO=Rua das Flores
ENDERECO_NUMERO=123
ENDERECO_BAIRRO=Centro
ENDERECO_MUNICIPIO=São Paulo
ENDERECO_UF=SP
ENDERECO_CEP=01310-100
CODIGO_MUNICIPIO_IBGE=3550308
OPTANTE_SIMPLES_NACIONAL=true

# ── Dados da Dentista ──────────────────────────────────────
NOME_DENTISTA=Dra. Fulana de Tal
CRO_DENTISTA=SP-12345
UF_CRO=SP
ESPECIALIDADE=Cirurgiã-Dentista Clínica Geral
CIDADE_CONSULTORIO=São Paulo

# ── Prompts Claude (cole o conteúdo dos arquivos em prompts/) ──
# Exemplo: PROMPT_SECRETARIA="Você é Sofia, secretária..."
# Na prática, carregue os prompts via script ou cole diretamente
PROMPT_SECRETARIA=
PROMPT_ANAMNESE=
PROMPT_PRESCRICAO=
PROMPT_LAUDO=
PROMPT_INSTAGRAM=
